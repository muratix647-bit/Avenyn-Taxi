# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/mobile/*/node_modules
/mobile/*/android/.gradle
/mobile/*/android/.kotlin
/mobile/*/android/app/build
/mobile/*/android/hs_err_pid*.log
/mobile/*/android/core.*
/mobile/*/android/key.properties
/mobile/*/android/app/*.jks
/mobile/*/android/app/*.keystore
/mobile/*/android/app/google-services.json
!/mobile/driver/android/app/google-services.json
/mobile/*/ios/App/App/GoogleService-Info.plist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Local archive staging files
.*.tar.gz.*
